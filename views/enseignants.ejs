<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Enseignants</title>
</head>
<body>

<% enseignants.forEach( enseignant => { %>
	<p>Prenom : <%= enseignant.prenom %></p>
	<p>Nom : <%= enseignant.nom %></p>
	<p>Email : <%= enseignant.mail %></p>
	<p>Sexe : <%= enseignant.sexe %></p>
	<p>Sexe : <%= enseignant.filiere %></p>
	<hr>

<% }); %>

</body>
</html>